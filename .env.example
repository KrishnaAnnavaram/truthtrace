# Copy to .env and fill in. .env is git-ignored: never commit it.
# LLM used for evidence-based judgements: none | fake | gemini | openai
TRUTHTRACE_LLM_PROVIDER=
TRUTHTRACE_LLM_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Embeddings: hashing | sentence-transformers:<model name>
TRUTHTRACE_EMBEDDER=
