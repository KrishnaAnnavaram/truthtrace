TRUTHTRACE_RERANKER=
TRUTHTRACE_DB_PATH=
TRUTHTRACE_TOP_K=
TRUTHTRACE_MATCH_THRESHOLD=
TRUTHTRACE_ABSTAIN_THRESHOLD=
TRUTHTRACE_CHUNK_WORDS=
TRUTHTRACE_CHUNK_OVERLAP=
TRUTHTRACE_CONTACT_URL=
TRUTHTRACE_REQUEST_DELAY=
TRUTHTRACE_MAX_ITEMS=
TRUTHTRACE_INGEST_INTERVAL_HOURS=
TRUTHTRACE_HISTORY_TURNS=
TRUTHTRACE_LOG_LEVEL=
